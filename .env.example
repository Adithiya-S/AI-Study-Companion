# AURA // AI Deep Focus & Telemetry Companion
# Environment Configuration Template

# Database Connection (defaults to SQLite if blank)
DATABASE_URL=sqlite:///data/study_companion.db

# Cryptographic Secret for JWT Sessions (generate with: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET=your_cryptographically_secure_random_jwt_secret_here

# Google Gemini API Key (Get your free key at: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Server Environment (development / production)
ENVIRONMENT=development
